@page
@model IndexModel
@{
    ViewData["Title"] = "Constellation Boundaries";
}

<form method="post">
    <div class="row">
        <div class="col-md-4">
            <h4>Viewer Settings</h4>
            <div class="mb-3">
                <label asp-for="Latitude" class="form-label"></label>
                <input asp-for="Latitude" class="form-control" step="0.0001" min="-90" max="90" />
            </div>
            <div class="mb-3">
                <label asp-for="Longitude" class="form-label"></label>
                <input asp-for="Longitude" class="form-control" step="0.0001" min="-180" max="180" />
            </div>
            <div class="mb-3">
                <label asp-for="DateTime" class="form-label">Date and Time (local)</label>
                <input asp-for="DateTime" class="form-control" type="datetime-local" step="1" />
            </div>
            <div class="mb-3">
                <label asp-for="Constellation" class="form-label"></label>
                <select asp-for="Constellation" asp-items="Model.Constellations" class="form-select"></select>
            </div>
            <button type="submit" class="btn btn-primary">Render</button>
        </div>
        <div class="col-md-8">
            @if (Model.RenderedImageDataUrl is not null)
            {
                <img src="@Model.RenderedImageDataUrl" width="600" height="600" alt="Constellation boundary" style="border: 1px solid #ccc;" />
            }
            else
            {
                <div style="width: 600px; height: 600px; border: 1px solid #ccc; background: #f0f0f0; display: flex; align-items: center; justify-content: center;">
                    <span class="text-muted">Click Render to display the constellation boundary.</span>
                </div>
            }
        </div>
    </div>
</form>
